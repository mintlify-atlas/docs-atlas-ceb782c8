  "keyFeatures": [
    "JWT access tokens delivered via HttpOnly cookies or Authorization Bearer header",
    "Rotating refresh tokens persisted in PostgreSQL and revocable per-session",
    "Google OAuth2 login with stateless cookie-based authorization request repository",
    "Email verification via one-time code sent through Resend",
    "TOTP-based two-factor authentication with QR setup, backup codes, and replay protection",
    "Per-user session management: up to 4 active sessions with device/OS/IP tracking",
    "OTP-based password reset that revokes all sessions on success",
    "Avatar upload with file signature validation, dimension limits, and Cloudinary storage",
    "Bucket4j + Caffeine rate limiting by operation category, keyed on user ID or client IP",
    "Role-based access control (USER / ADMIN) enforced at controller and method level",
    "Uniform RFC 9457 ProblemDetail error responses",
    "OpenAPI / Swagger UI documentation auto-generated at runtime"
  ],
  "publicApiSurface": [
    "POST /api/v1/auth/register",
    "POST /api/v1/auth/verify-email",
    "POST /api/v1/auth/resend-verification",
    "POST /api/v1/auth/login",
